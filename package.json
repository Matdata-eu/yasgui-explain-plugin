{
  "name": "@matdata/yasgui-plan-plugin",
  "private": false,
  "version": "0.1.0",
  "description": "Explain view for YASGUI and MatGUI: the SPARQL algebra of a query, and the execution plan with timings from QLever, GraphDB, Stardog, Blazegraph and Neptune",
  "main": "dist/yasgui-plan-plugin.cjs.js",
  "module": "dist/yasgui-plan-plugin.esm.js",
  "unpkg": "dist/yasgui-plan-plugin.min.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build --base=/yasgui-plan-plugin/",
    "build": "node esbuild.config.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matdata-eu/yasgui-plan-plugin.git"
  },
  "keywords": [
    "yasgui",
    "yasr",
    "matgui",
    "sparql",
    "rdf",
    "sparql-algebra",
    "query-plan",
    "explain",
    "qlever",
    "graphdb",
    "stardog",
    "blazegraph"
  ],
  "author": "Matdata",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Matdata-eu/yasgui-plan-plugin/issues"
  },
  "homepage": "https://github.com/Matdata-eu/yasgui-plan-plugin#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@traqula/algebra-sparql-1-2": "^1.4.0",
    "@traqula/parser-sparql-1-2": "^1.4.0"
  },
  "devDependencies": {
    "@matdata/yasgui": "^6.8.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "cssnano": "^7.1.9",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.29",
    "postcss-import": "^16.2.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
